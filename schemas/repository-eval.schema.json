{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aya.dev/agent-governance/schemas/repository-eval.schema.json",
  "title": "Aya Repository Behavioral Eval",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "category",
    "agent",
    "scenario",
    "expect"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[A-Z][A-Z0-9-]*-[0-9]{3}$"
    },
    "category": {
      "type": "string",
      "minLength": 1
    },
    "agent": {
      "type": "string",
      "minLength": 1
    },
    "scenario": {
      "type": "string",
      "minLength": 1
    },
    "expect": {
      "type": "object",
      "minProperties": 1,
      "maxProperties": 16,
      "propertyNames": {
        "pattern": "^[a-z][a-z0-9_]*$"
      },
      "additionalProperties": {
        "type": "boolean"
      }
    }
  }
}
